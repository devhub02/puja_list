{
  "expo": {
    "name": "Puja Saathi",
    "slug": "puja-saathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/app-icon.png",
    "scheme": "pujasaathi",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF8EC",
    "platforms": ["android"],
    "android": {
      "package": "com.pujasaathi.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EC",
        "foregroundImage": "./assets/images/brand/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EC",
          "image": "./assets/images/brand/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#FFF8EC",
            "image": "./assets/images/brand/splash-icon.png"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
